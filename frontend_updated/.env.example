# local = browse the bundled metadata snapshot; AI features show a "not connected" state.
# api   = call the FastAPI backend for search, recommendations and AI (Step 3).
VITE_DATA_SOURCE=local
# In dev, /api is proxied by Vite to VITE_PROXY_TARGET (the backend has no CORS middleware).
VITE_API_BASE_URL=/api
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Route guard. Leave off until real authentication exists (Step 2); then set to `on`:
# signed-out -> /signin, signed-in without onboarding -> /onboarding.
VITE_AUTH_GUARD=off
